# Unsteady companion to exact.inpt: the temperature also rises linearly in
# time, T = T0 +c*t +G*y (source rho*cv*(ay*G +c)), with E = 2, nu = 0.25.
# The displacement follows quasi-statically and should match to round-off
# at every time step (helper: l2error).
logfile: unsteady
log2p: 1
extra_finest_levels: 1
ngrid: 3
ncycle: 1000
absolute_tolerance: 1.0e-12
relative_tolerance: 1.0e-10
ntstep: 3
dtinv: 2.0
nblock: 1
blocktype: thermoelastic
b0_mesh: square4.grd
# Elastic constants
E: 2.0
nu: 0.25
b0_E: E
b0_nu: nu
# Thermal expansion coefficient and stress free temperature
alpha: 0.01
T_ref: 0.5
# Heat equation: rho*cv*(a.grad(T)) = div(k grad(T)) +src
rho: 1.0
cv: 1.0
conductivity: 1.0
ax: 0.0
ay: 0.5
T0: 1.0
G: 2.0
src: symbolic
c: 0.5
src0: rho*cv*(ay*G +c)
# Variables are (u, v, T, p)
# Zero initial guess at t = 0, exact solution afterwards (Dirichlet values + l2error)
ibc: symbolic
ibc0: (1+nu)*alpha*(((T0+c*t)-T_ref)*x0 +G*x0*x1)
ibc1: (1+nu)*alpha*(((T0+c*t)-T_ref)*x1 +G*(x1*x1 -x0*x0)/2)
ibc2: (T0+c*t) +G*x1
ibc3: E*alpha*((T0+c*t) +G*x1 -T_ref)
helper: l2error
# Bottom: displacement and temperature set; top: temperature set, traction free;
# sides: traction free and adiabatic
b0_s1_hp_type: dirichlet
b0_s2_hp_type: neumann
b0_s3_hp_type: temperature
b0_s4_hp_type: neumann

