logfile: generate
nblock: 3
ntstep: 3
adapt: 1
log2p: 0
time_scheme: 1
petsc: -ksp_type preonly -pc_type lu -pc_factor_mat_solver_type mumps
# automatic cut-off for multigrid cycles: 
absolute_tolerance: 1.0e-9
relative_tolerance: 1.0e-5
growth factor: 50000
#rsdl_debug: 1
# Sphere initial/boundary condition gives u = 1 outside of outer_radius: 
# and 0 inside inner radius with smooth transition in between: 
ibc: sphere
inner_radius: 5.0
outer_radius: 10.0
# ibc: symbolic
# ibc0: 1.0
# ibc1: 0.0
# ibc2: 0.0
# Viscosity (1/Reynolds Number): 
mu: 1.0e-1
rho: 1.0
delta: 0.05
b0_type: r_tri_mesh
b0_mesh: b0.d
b0_metric: mapped_edge
b0_s2_hp_type: outflow
b0_s3_hp_type: outflow
b0_s4_hp_type: outflow
b0_s5_hp_type: inflow
b0_s10_type: mapped_comm
b0_s10_mapping: spline_log
b0_s10_normal_coordinate: 0.0
b0_s7_type: mapped_comm
b0_s7_mapping: polar_log
b0_s7_normal_coordinate: 0.0
b2_s6_type: prdc
b0_v2_type: comm
b0_v3_type: comm
b1_mesh: b1.d
b1_type: mapped_mesh
b1_metric: mapped
b1_mapping: spline_log
b1_s10_type: mapped_mesh_comm
b1_s11_type: plain
b1_s11_hp_type: inflow
b1_s6_type: prdc
b1_s8_type: prdc
b1_v2_type: mapped_mesh_comm
b1_v3_type: mapped_mesh_comm
#b1_v4_type: prdc
#b1_v4_hp_type: plain
#b1_v4_hp_typelist: 0 0 1
#b1_v5_type: prdc
#b1_v5_hp_type: plain
#b1_v5_hp_typelist: 0 0 1
b2_mesh: b2.d
b2_type: mapped_mesh
b2_metric: mapped
b2_mapping: polar_log
b2_s6_type: prdc
b2_s7_type: mapped_mesh_comm
b2_s8_type: prdc
b2_v2_type: mapped_mesh_comm
b2_v3_type: mapped_mesh_comm
#b2_v4_type: prdc
#b2_v4_hp_type: plain
#b2_v4_hp_typelist: 0 0 1
#b2_v5_type: prdc
#b2_v5_hp_type: plain
#b2_v5_hp_typelist: 0 0 1
b2_s9_hp_typelist: 0 0 1
b2_s9_flux2: 0.0
polar_log_type: polar_log
polar_log_pnt: 1.0 0.0
polar_log_theta_length: r0
polar_log_r0: r0
polar_log_eps: eps
spline_log_type: spline_log
spline_log_spline: naca.spl
spline_log_r0: r0
spline_log_r_eps: eps
r0: delta
eps: 4.0e-2
bottom: r0*log(eps/(1+eps))
res: 0.0125
