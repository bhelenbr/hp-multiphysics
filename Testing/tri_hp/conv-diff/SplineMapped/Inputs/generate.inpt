ntstep: 2
log2p: 2
adapt: 1
error_estimator: energy_norm
error_target: 1.000e-04
logfile: generate
growth factor: 100.0
petsc: -ksp_type preonly -pc_type lu -pc_factor_mat_solver_type mumps
nu: 1.0
ax: 0.0
ay: 0.0
b0_mesh: rectangle.d
b0_type: cd
b0_metric: mapped
b0_mapping: spline
b0_spline: flat.spl
b0_s1_hp_type: dirichlet
b0_s2_hp_type: adiabatic
b0_s3_hp_type: dirichlet
b0_s4_hp_type: adiabatic
helper: l2error
ibc0: x1
ibc: symbolic
h: 0.25
res: h/4
#b0_s1_filename: naca.spl
#b0_s1_norm_dist: -0.05
#b0_s1_s_limits: 0. 1.
#b0_s11_type: spline_comm
