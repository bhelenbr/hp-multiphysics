log2p: 0
adapt: 1
logfile: generate
nblock: 2
ntstep: 3
petsc: -ksp_type preonly -pc_type lu -pc_factor_mat_solver_type mumps
ncycle: 0
growth factor: 50000
height: 0.1
res: height/8
nu: 1.0
ax: 0.0
ay: 0.0
r: sqrt(x0^2+x1^2)
theta: (x0>0 ? atan2(-x0,x1)+2*_pi : atan2(-x0,x1))
ibc: symbolic
ibc0: (3.0/2.0)*(r^(2.0/3.0))*sin(2.0*theta/3.0)*(1-x0^2)*(1-x1^2)
src: symbolic
#src0: -(3.0*x0^4*sin(2.0*theta/3.0) -10.0*x0^2*sin(2.0*theta/3.0) -10.0*x1^2*sin(2.0*theta/3.0) +3.0*x1^4*sin(2.0*theta/3.0) +4.0*x0*x1^3*cos(2.0*theta/3.0) -4.0*x0^3*x1*cos(2.0*theta/3.0) +14.0*x0^2*x1^2*sin(2.0*theta/3.0))/(r^(4.0/3.0))
src0: -r^(2.0/3.0)*(4.0*r^2*sin(2.0*theta/3.0) -10.0*sin(2.0*theta/3.0) +r^2*sin(10.0*theta/3.0))
helper: l2error
b0_mesh: b0.d
b0_type: r_tri_mesh
b0_metric: mapped_edge
b0_mapping: none
b0_s4_center: 0.0000000000e+00 0.0000000000e+00
b0_s4_radius: height
b0_s4_type: circle_comm
b0_s1_hp_type: dirichlet
b0_s1_ibc: symbolic
b0_s1_ibc0: 0
b0_s2_hp_type: dirichlet
b0_s2_ibc: symbolic
b0_s2_ibc0: 0
b0_s3_hp_type: dirichlet
b0_s3_ibc: symbolic
b0_s3_ibc0: 0
b0_s5_hp_type: dirichlet
b0_s5_ibc: symbolic
b0_s5_ibc0: 0
b0_s6_hp_type: dirichlet
b0_s6_ibc: symbolic
b0_s6_ibc0: 0
b0_s7_hp_type: dirichlet
b0_s7_ibc: symbolic
b0_s7_ibc0: 0
b1_mesh: b1.d
b1_type: mapped_mesh
b1_metric: mapped
b1_mapping: polar
b1_pnt: 0.0000000000e+00 0.0000000000e+00
b1_theta_length: height
b1_theta0: 5*_pi/4
b1_s9_hp_type: dirichlet
b1_s9_ibc: symbolic
b1_s9_ibc0: 0
b1_s11_hp_type: dirichlet
b1_s11_ibc: symbolic
b1_s11_ibc0: 0
b1_s8_hp_type: dirichlet
b1_s8_ibc: symbolic
b1_s8_ibc0: 0
b1_s4_type: mapped_comm
#b0_s4_type: circle
#b1_s4_hp_type: dirichlet
#b0_s4_hp_type: dirichlet
